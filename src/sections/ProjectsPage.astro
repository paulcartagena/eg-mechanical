---
import { Image } from "astro:assets";
import project01 from "../assets/images/01-project.jpeg";
import project02 from "../assets/images/02-project.jpeg";
import project03 from "../assets/images/03-project.jpeg";
import project04 from "../assets/images/04-project.jpeg";
import project05 from "../assets/images/05-project.jpeg";
import project06 from "../assets/images/06-project.jpeg";
import project07 from "../assets/images/07-project.jpeg";
import project09 from "../assets/images/09-project.jpeg";
import project11 from "../assets/images/11-project.jpeg";
import project12 from "../assets/images/12-project.jpeg";
import project14 from "../assets/images/14-project.jpeg";
import project15 from "../assets/images/15-project.jpeg";
---

<section id="contact" class="flex mt-36">
  <div class="container flex flex-col gap-5 mx-auto px-8">
    <h2 class="text-4xl md:text-5xl font-bold text-center md:text-left">
      Projects
    </h2>
    <p
      class="text-base text-center w-full md:w-1/2 md:text-left md:text-balance opacity-80"
    >
      Discover more about our outstanding work.
    </p>

    <!-- Masonry Grid -->
    <div
      class="mt-10 sm:mt-4 grid grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[150px]"
    >
      <!-- Image 1 -->
      <div class="overflow-hidden rounded-lg row-span-2 lg:col-span-2">
        <Image
          src={project01}
          alt="HVAC and plumbing project 1"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 2 -->
      <div class="overflow-hidden rounded-lg lg:row-span-1">
        <Image
          src={project02}
          alt="HVAC and plumbing project 2"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 3 -->
      <div class="overflow-hidden rounded-lg lg:row-span-1">
        <Image
          src={project03}
          alt="HVAC and plumbing project 3"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 4 -->
      <div class="overflow-hidden rounded-lg lg:row-span-3 lg:col-span-2">
        <Image
          src={project04}
          alt="HVAC and plumbing project 4"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 5 -->
      <div class="overflow-hidden rounded-lg row-span-2 lg:hidden">
        <Image
          src={project05}
          alt="HVAC and plumbing project 5"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 6 -->
      <div class="overflow-hidden rounded-lg row-span-2">
        <Image
          src={project06}
          alt="HVAC and plumbing project 6"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 7 -->
      <div class="overflow-hidden rounded-lg lg:row-span-2">
        <Image
          src={project07}
          alt="HVAC and plumbing project 7"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 8 -->
      <div class="overflow-hidden rounded-lg row-span-3 lg:col-span-1">
        <Image
          src={project09}
          alt="HVAC and plumbing project 8"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 9 -->
      <div class="overflow-hidden rounded-lg row-span-3 lg:col-span-1">
        <Image
          src={project12}
          alt="HVAC and plumbing project 9"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 10 -->
      <div class="overflow-hidden rounded-lg row-span-2 lg:col-span-2">
        <Image
          src={project14}
          alt="HVAC and plumbing project 10"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 11 -->
      <div class="overflow-hidden rounded-lg row-span-1 lg:col-span-1">
        <Image
          src={project11}
          alt="HVAC and plumbing project 11"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Image 12 -->
      <div class="overflow-hidden rounded-lg row-span-1 lg:col-span-1">
        <Image
          src={project15}
          alt="HVAC and plumbing project 12"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
